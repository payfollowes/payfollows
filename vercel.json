{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/admin/cron/sync-providers", "schedule": "0 0 * * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...route].js" },
    { "src": "/webhook/(.*)", "dest": "/api/webhook/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
