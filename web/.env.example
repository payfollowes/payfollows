# Supabase (public client keys — same project as the legacy panel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_public_anon_key

# Legacy backend (Vite panel) that owns the serverless API + payment webhooks.
# Leave empty to use relative /api paths (Next rewrites proxy them in dev).
NEXT_PUBLIC_API_BASE_URL=https://payfollows.vercel.app

# FastPay (public merchant id used by the deposit flow)
NEXT_PUBLIC_FASTPAY_MERCHANT_ID=replace_with_fastpay_merchant_id
NEXT_PUBLIC_FASTPAY_BASE_URL=https://api.fastpay.com/v1
